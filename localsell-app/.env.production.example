# LocalSell customer app — production build env.
# Copy to `.env.production` (git-ignored) and fill in. The local build scripts
# source this file (see APP_BUILD_PLAN.md §3–4). Values marked EXPO_PUBLIC_* are
# inlined into the JS bundle; the rest are read by app.config.js at build time.

# --- API the store binary talks to ---
EXPO_PUBLIC_GRAPHQL_URL=https://api.localsell.in/graphql
EXPO_PUBLIC_WS_GRAPHQL_URL=wss://api.localsell.in/graphql

# --- build channel ---
APP_ENV=production
EXPO_PUBLIC_APP_ENV=production

# --- Google Maps SDK keys (LocalSell Google Cloud project) ---
# Android key: restrict by package `in.localsell.customer` + release signing SHA-1.
# iOS key: restrict by bundle id `in.localsell.customer`.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# --- Google Sign-In OAuth client ids (LocalSell Google Cloud project) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed form of the iOS client id (com.googleusercontent.apps.<n>-<hash>).
EXPO_PUBLIC_GOOGLE_IOS_REVERSED_CLIENT_ID=

# --- Apple ---
APPLE_TEAM_ID=
