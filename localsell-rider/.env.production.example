# LocalSell rider (delivery) app — production build env.
# Copy to `.env.production` (git-ignored) and fill in. See APP_BUILD_PLAN.md §3–4.

# --- API the binary talks to ---
EXPO_PUBLIC_GRAPHQL_URL=https://api.localsell.in/graphql
EXPO_PUBLIC_WS_GRAPHQL_URL=wss://api.localsell.in/graphql

# --- build channel ---
EXPO_PUBLIC_APP_ENV=production

# --- Google Maps SDK keys (LocalSell Google Cloud project) ---
# Android: restrict by package `in.localsell.rider` + release signing SHA-1.
# iOS: restrict by bundle id `in.localsell.rider`.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
