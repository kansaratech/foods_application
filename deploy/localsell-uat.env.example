# ============================================================
#  LocalSell deployment environment — UAT
#  Copy to  deploy/localsell.env  INSIDE THE UAT SERVER DIRECTORY (e.g.
#  ~/localsell-uat/deploy/localsell.env — same filename as prod, different
#  directory), fill every CHANGE_ME, then:  chmod 600 deploy/localsell.env
#  deploy/localsell.env is git-ignored — never commit real secrets.
#
#  Used two ways by `docker compose -p localsell-uat --env-file deploy/localsell.env ...`:
#    - fills the frontend build ARGs (NEXT_PUBLIC_* / EXPO_PUBLIC_*) at image build
#    - provides the api container's runtime environment
# ============================================================

# ---- Compose project identity — keeps prod/UAT containers, images and the
# internal Docker network from colliding when both run on this server ----
CONTAINER_PREFIX=localsell_uat
WEB_PORT=6100
ADMIN_PORT=6101
API_PORT=6102
STORE_PORT=6104
RIDER_PORT=6105

# ---- MySQL --------------------------------------------------
# Same shared MySQL container as prod, SEPARATE database (`localsell_uat`) —
# see LOCALSELL_DEPLOYMENT.md §4. Password: `openssl rand -hex 24`.
DATABASE_URL=mysql://localsell_uat:CHANGE_ME_DB_PASSWORD@CHANGE_ME_MYSQL_CONTAINER:3306/localsell_uat

# ---- API secrets — unique per deployment, DO NOT reuse prod's (openssl rand -hex 32) ----
JWT_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN=90d

# ---- API runtime -----------------------------------------
PORT=4000
# Explicit origin list — never "*".
CORS_ORIGIN=https://uat.localsell.in,https://uat-admin.localsell.in,https://uat-store.localsell.in
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_URL=https://uat-api.localsell.in/uploads
WEB_CLIENT_URL=https://uat.localsell.in

# ---- Uploads storage — MUST be a different host path than prod's, or the
# two environments will read/write each other's uploaded files ----
UPLOADS_HOST_DIR=/var/localsell-uat/uploads

# ---- Frontend build-time vars (compiled into web + admin bundles) ----
NEXT_PUBLIC_SERVER_URL=https://uat-api.localsell.in/
NEXT_PUBLIC_WS_SERVER_URL=wss://uat-api.localsell.in/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME_MAPS_BROWSER_KEY

# ---- Store merchant web (compiled into the Expo web export) ----
EXPO_PUBLIC_GRAPHQL_URL=https://uat-api.localsell.in/graphql
EXPO_PUBLIC_WS_GRAPHQL_URL=wss://uat-api.localsell.in/graphql

# ---- Transactional email ----
# Leave blank to keep UAT email off (recommended — avoids sending test emails
# to real addresses); set it if you actually want UAT to send mail.
SMTP_PASSWORD=

# ---- UAT admin seed (one-off, NOT read by the running app) ----
# UAT keeps the full copied dataset (see LOCALSELL_DEPLOYMENT.md §4) — this is
# only relevant if UAT is ever reseeded from seed-data.json (demo dataset).
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD

# ---- WhatsApp Cloud API (Meta) ----
# Recommend leaving this BLANK for UAT so test orders never send real WhatsApp
# messages to real numbers. Set it only if you deliberately want to test the
# WhatsApp flow end-to-end against a test number.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_RANDOM_STRING
WHATSAPP_APP_SECRET=
