# ============================================================
#  LocalSell deployment environment — PRODUCTION
#  Copy to  deploy/localsell.env , fill every CHANGE_ME, then:  chmod 600 deploy/localsell.env
#  deploy/localsell.env is git-ignored — never commit real secrets.
#
#  For UAT, use deploy/localsell-uat.env.example instead — it's the same file
#  shape with UAT hostnames/ports/DB. Prod and UAT are two SEPARATE server
#  directories (e.g. ~/localsell-prod/, ~/localsell-uat/), each with its own
#  deploy/localsell.env (same filename, different content per directory) —
#  see docker-compose.yml's header comment and LOCALSELL_DEPLOYMENT.md §12.6.
#
#  Used two ways by `docker compose -p localsell-prod --env-file deploy/localsell.env ...`:
#    - fills the frontend build ARGs (NEXT_PUBLIC_* / EXPO_PUBLIC_*) at image build
#    - provides the api container's runtime environment
# ============================================================

# ---- Compose project identity — keeps prod/UAT containers, images and the
# internal Docker network from colliding when both run on this server ----
CONTAINER_PREFIX=localsell_prod
WEB_PORT=6000
ADMIN_PORT=6001
API_PORT=6002
STORE_PORT=6004
RIDER_PORT=6005

# ---- MySQL --------------------------------------------------
# New database + user on the shared MySQL container.
# Host = the MySQL *container name* (NOT localhost); port is the container-internal
# 3306 even if the container publishes a different host port.
#   docker network inspect mysql_config_dev_default --format '{{range .Containers}}{{.Name}} {{end}}'
# Password: generate with `openssl rand -hex 24` (hex = URL-safe, no escaping in the URL).
DATABASE_URL=mysql://localsell_prod:CHANGE_ME_DB_PASSWORD@CHANGE_ME_MYSQL_CONTAINER:3306/localsell_prod

# ---- API secrets — unique per deployment (openssl rand -hex 32) ----
JWT_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN=90d

# ---- API runtime -----------------------------------------
PORT=4000
# Explicit origin list — never "*".
CORS_ORIGIN=https://localsell.in,https://admin.localsell.in,https://store.localsell.in
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_URL=https://api.localsell.in/uploads
# Base URL of the customer web app — used ONLY to build the Cashfree
# return_url the customer is sent back to after hosted checkout. No trailing
# slash. If this is missing/unset, the api silently falls back to
# http://localhost:3000 and every online payment returns customers to a dead
# localhost link instead of the live site.
WEB_CLIENT_URL=https://localsell.in

# ---- Uploads storage (compose-level, not read by the api process) --------
# Host directory bind-mounted into the api container at /app/uploads. A plain
# folder (not a Docker named volume) so backup/rsync/replica scripts can read
# it directly. Create it once on the host: mkdir -p /var/localsell/uploads
# Uncomment to override the default:
# UPLOADS_HOST_DIR=/var/localsell/uploads

# ---- Frontend build-time vars (compiled into web + admin bundles) ----
NEXT_PUBLIC_SERVER_URL=https://api.localsell.in/
NEXT_PUBLIC_WS_SERVER_URL=wss://api.localsell.in/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME_MAPS_BROWSER_KEY

# ---- Store merchant web (compiled into the Expo web export) ----
EXPO_PUBLIC_GRAPHQL_URL=https://api.localsell.in/graphql
EXPO_PUBLIC_WS_GRAPHQL_URL=wss://api.localsell.in/graphql

# ---- Transactional email ----
# Gmail app password. Host/port/user live in prisma/seed-data.json; the seed
# reads this into Configuration.emailPassword. Leave blank to keep email off.
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD

# ---- Production admin seed (one-off, NOT read by the running app) ----
# Only used when running `npm run seed:prod` (SEED_DATA_FILE=seed-data.prod.json)
# to set the initial admin@localsell.in password without putting a real
# password in a committed JSON file. Generate with `openssl rand -base64 18`,
# seed once, then remove/blank this line — it is not needed after that.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD

# ---- WhatsApp Cloud API (Meta) ----
# Permanent System User token. Non-secret IDs (phone number ID, WABA ID) are set
# in the admin panel → Configuration → WhatsApp, or prisma/seed-data.json.
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_META_SYSTEM_USER_TOKEN
# Webhook: enter WHATSAPP_VERIFY_TOKEN as the "Verify token" in Meta → WhatsApp →
# Configuration → Webhook (callback URL https://api.localsell.in/webhooks/whatsapp,
# subscribe to "messages" + "message_template_status_update"). WHATSAPP_APP_SECRET
# (Meta App → Settings → Basic) turns on signature checking.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_RANDOM_STRING
WHATSAPP_APP_SECRET=
