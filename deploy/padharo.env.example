# ============================================================
#  Padharo deployment environment
#  Copy this file to  deploy/padharo.env  and fill in every CHANGE_ME.
#  deploy/padharo.env is git-ignored — never commit real secrets.
# ============================================================

# ---- MySQL --------------------------------------------------
# New database + user on the shared MySQL container.
# Host = the MySQL *container name* on the mysql_config_dev_default network.
# Find it with:  docker network inspect mysql_config_dev_default --format '{{range .Containers}}{{.Name}} {{end}}'
DATABASE_URL=mysql://padharo:CHANGE_ME_DB_PASSWORD@CHANGE_ME_MYSQL_CONTAINER:3306/padharo

# ---- API secrets (generate each: openssl rand -hex 32) -----
JWT_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN=90d

# ---- API runtime ------------------------------------------
PORT=4000
CORS_ORIGIN=https://padharo.kansaratech.com,https://padharo-admin.kansaratech.com,https://padharo-store.kansaratech.com
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_URL=https://padharo-api.kansaratech.com/uploads

# ---- Frontend build-time vars (baked into web + admin bundles) ----
NEXT_PUBLIC_SERVER_URL=https://padharo-api.kansaratech.com/
NEXT_PUBLIC_WS_SERVER_URL=wss://padharo-api.kansaratech.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyByQslS8CFpwauY6LgcfOqdhWUohLRYN-Q

# ---- Admin login prefill (optional convenience only) -------
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_PASSWORD=

# ---- Store merchant web (padharo-store.kansaratech.com) ----
# Inlined into the Expo web export at build time.
EXPO_PUBLIC_GRAPHQL_URL=https://padharo-api.kansaratech.com/graphql
EXPO_PUBLIC_WS_GRAPHQL_URL=wss://padharo-api.kansaratech.com/graphql
