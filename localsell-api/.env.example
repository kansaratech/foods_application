# ============================================================
#  localsell-api — local dev environment
#  Copy to  localsell-api/.env  (git-ignored) and fill the CHANGE_ME values:
#      cp .env.example .env
#  Then:   npm run db:deploy -- --demo     (schema + client + config + seed)
#          npm run dev
#  For SERVER/prod env see deploy/localsell.env.example instead.
# ============================================================

# ---- Database (required) -----------------------------------
# MySQL 8. Create an empty database named `localsell` first (see LOCAL_SETUP.md
# "Track B → 1. Database"). Docker one-liner uses root/root:
DATABASE_URL="mysql://root:root@localhost:3306/localsell"
# Native install / dedicated user variants:
#   mysql://root:<YOUR_ROOT_PASSWORD>@localhost:3306/localsell
#   mysql://localsell:localsell@localhost:3306/localsell
# If the password has @ : / ? or spaces, URL-encode it (@ -> %40).

# ---- API runtime -----------------------------------------
PORT=4000

# Any random string is fine for local dev. Generate: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_access_secret"
JWT_EXPIRES_IN="30d"
REFRESH_TOKEN_SECRET="CHANGE_ME_refresh_secret"
REFRESH_TOKEN_EXPIRES_IN="90d"

# Comma-separated allowed origins, or "*" for all. "*" is dev-only — never on a server.
CORS_ORIGIN="*"

UPLOAD_DIR="uploads"
PUBLIC_UPLOAD_URL="http://localhost:4000/uploads"

# ---- Transactional email (SMTP) --------------------------
# Gmail app password for localsell.dgh@gmail.com (smtp.gmail.com:465 SSL).
# Host / port / user / from-address live in prisma/seed-data.json → configuration;
# ONLY the password comes from here. `npm run seed` and `npm run db:deploy` read
# this into Configuration.emailPassword. The API reads that DB column at runtime,
# not this variable.
#   - Leave blank  -> email stays OFF, OTP/reset fall back to a console log
#                     (skipEmail/skipMobile verification is on by default anyway).
#   - Get the real value from the team lead (password manager / DM) — do NOT commit it.
SMTP_PASSWORD=""

# ---- Optional: SMTP overrides for a bare `npm run db:deploy` (no --demo) ----
# The --demo seed always takes these non-secret fields from seed-data.json, so
# you only need these if you run db:deploy WITHOUT --demo against a fresh DB.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="localsell.dgh@gmail.com"
# SMTP_FROM="localsell.dgh@gmail.com"
# SMTP_FROM_NAME="LocalSell"

# ---- Optional: Configuration-row defaults (only used by db:deploy, pre-seed) ----
# The --demo seed sets these from seed-data.json; override here only for a
# non-demo bring-up in a different town / currency.
# CURRENCY="INR"
# CURRENCY_SYMBOL="₹"
# DEFAULT_COMMISSION_RATE=20
# COMMISSION_CYCLE="MONTHLY"
# RIDER_CASH_LIMIT=3000
# MARKETPLACE_LAT=25.534
# MARKETPLACE_LNG=73.899
# PLATFORM_LEGAL_NAME="Maekotech Solutions LLP"
