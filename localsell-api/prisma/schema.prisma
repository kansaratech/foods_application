generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  CUSTOMER
  VENDOR
  ADMIN
  RIDER
  STAFF
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PICKED
  ASSIGNED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// Tracks the refund of an online payment back to the customer after a
// cancelled order. NONE = nothing to refund (COD, or never paid).
enum RefundStatus {
  NONE
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String?   @unique
  phone                  String?   @unique
  username               String?   @unique
  password               String?
  phoneIsVerified        Boolean   @default(false)
  emailIsVerified        Boolean   @default(false)
  isActive               Boolean   @default(true)
  status                 String    @default("ACTIVE")
  notes                  String?   @db.Text
  isOrderNotification    Boolean   @default(true)
  isOfferNotification    Boolean   @default(true)
  notificationToken      String?
  userType               UserType  @default(CUSTOMER)
  image                  String?
  firstName              String?
  lastName               String?
  appleId                String?
  favouriteRestaurantIds Json?     @default("[]")
  otpCode                String?
  otpExpiresAt           DateTime?
  permissions            Json?
  tokenVersion           Int       @default(0)
  // Stamped on every successful login (all types/branches) — the admin
  // Customers directory's "Last active" column read this field but it never
  // existed, so every row showed "?" (Issue: customers list question marks).
  lastLogin              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Vendor registration business details (Localsell vendor registration spec).
  // Store-level fields (address, delivery zone, timings, etc.) stay on
  // Restaurant and are deliberately not duplicated here.
  businessName        String?
  businessTypeId      String?
  isGstRegistered     Boolean @default(false)
  gstin               String?
  // Vendor-level default, copied onto each new Restaurant on creation (and
  // editable per-store after, since a multi-store vendor can hold different
  // GSTINs per state). REGULAR | COMPOSITION | UNREGISTERED. `isGstRegistered`
  // is kept in sync (`!== UNREGISTERED`) so existing reads of it still work.
  gstRegistrationType String  @default("UNREGISTERED")

  addresses         Address[]
  restaurants       Restaurant[]       @relation("RestaurantOwner")
  orders            Order[]            @relation("OrderCustomer")
  riderOrders       Order[]            @relation("OrderRider")
  riderProfile      RiderProfile?
  reviews           Review[]
  withdrawRequests  WithdrawRequest[]
  transactions      Transaction[]
  supportTickets    SupportTicket[]
  webNotifications  WebNotification[]
  orderChatMessages OrderChatMessage[]
  vendorDocuments   VendorDocument[]
  riderDocuments    RiderDocument[]
  businessType      ShopType?          @relation(fields: [businessTypeId], references: [id])

  @@index([businessTypeId])
}

model Address {
  id              String  @id @default(cuid())
  userId          String
  label           String?
  deliveryAddress String? @db.Text
  details         String?
  latitude        Float?
  longitude       Float?
  selected        Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model ShopType {
  id       String  @id @default(cuid())
  name     String
  image    String?
  slug     String  @unique
  isActive Boolean @default(true)

  cuisines    Cuisine[]
  restaurants Restaurant[]
  vendors     User[]
}

model Cuisine {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  image       String?
  shopTypeId  String?

  shopType    ShopType?           @relation(fields: [shopTypeId], references: [id])
  restaurants RestaurantCuisine[]

  @@index([shopTypeId])
}

model Restaurant {
  assignedRiders RiderProfile[] @relation("RiderAssignedStore")
  id                    String    @id @default(cuid())
  ownerId               String
  name                  String
  description           String?   @db.Text
  image                 String?
  logo                  String?
  address               String?   @db.Text
  phone                 String?
  // Store dashboard login. Not globally unique — one vendor can run several
  // outlets under the same login email, each with its own password, and
  // `restaurantLogin` matches on username + password (#59).
  username              String?
  password              String?
  slug                  String    @unique
  orderPrefix           String?
  deliveryTime          Int       @default(30)
  minimumOrder          Float     @default(0)
  // Default GST rate %, meaningful only when gstRegistrationType = REGULAR.
  // COMPOSITION/UNREGISTERED stores never charge tax regardless of this value
  // (composition dealers are legally barred from collecting tax separately —
  // Section 10 CGST Act). If REGULAR and left at 0, the pricing engine falls
  // back to 5% (standard restaurant GST rate) rather than silently charging none.
  tax                   Float     @default(0)
  // REGULAR | COMPOSITION | UNREGISTERED — drives the tax engine in
  // order.service.ts / pricing.service.ts. Defaults from the owning vendor's
  // User.gstRegistrationType when a store is created, editable per store.
  gstRegistrationType   String    @default("UNREGISTERED")
  gstin                 String?
  commissionRate        Float     @default(0)
  isActive              Boolean   @default(true)
  isAvailable           Boolean   @default(true)
  // Onboarding gate. A store created by a VENDOR starts PENDING and is invisible
  // to customers until an admin approves it. Stores created by an ADMIN, and
  // every store that predates this column, are APPROVED.
  approvalStatus        String    @default("APPROVED") // PENDING | APPROVED | REJECTED | SUSPENDED
  approvalNote          String?   @db.Text
  approvedAt            DateTime?
  approvedById          String?
  latitude              Float?
  longitude             Float?
  shopTypeId            String?
  openingTimes          Json?
  bussinessDetails      Json?
  currentWalletAmount   Float     @default(0)
  totalWalletAmount     Float     @default(0)
  withdrawnWalletAmount Float     @default(0)
  deliveryBounds        Json?
  circleBounds          Json?
  boundType             String?
  city                  String?
  state                 String?
  postCode              String?
  pickup                Boolean   @default(true)
  delivery              Boolean   @default(true)
  // Who fulfils a delivery order for this store. Only meaningful when
  // `delivery = true`; "pickup only" is `delivery = false`.
  //   PLATFORM — the LocalSell hyperlocal rider fleet (zone dispatch)
  //   SELF     — the store delivers with its own people (StoreDeliveryAgent)
  //   BOTH     — store decides per order after accepting it
  deliveryProvider      String    @default("PLATFORM")
  minDeliveryFee        Float?
  deliveryDistance      Float?
  // "per_km"  — deliveryFee is a per-km rate, multiplied by ceil(distanceKm), floored by minDeliveryFee
  // "fixed"   — deliveryFee is a flat lump-sum charge regardless of distance
  deliveryFeeType       String    @default("per_km")
  deliveryFee           Float?
  clonedFromId          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner            User                 @relation("RestaurantOwner", fields: [ownerId], references: [id])
  shopType         ShopType?            @relation(fields: [shopTypeId], references: [id])
  cuisines         RestaurantCuisine[]
  categories       Category[]
  addons           Addon[]
  orders           Order[]
  coupons          Coupon[]
  reviews          Review[]
  withdrawRequests WithdrawRequest[]
  transactions     Transaction[]
  documents        StoreDocument[]
  deliveryAgents   StoreDeliveryAgent[]
  clonedFrom       Restaurant?          @relation("RestaurantClone", fields: [clonedFromId], references: [id])
  clones           Restaurant[]         @relation("RestaurantClone")

  @@index([ownerId])
  @@index([ownerId, username])
  @@index([shopTypeId])
  @@index([clonedFromId])
}

// A compliance document a store submits and an admin verifies. Not a launch
// blocker (a store can trade with docs still PENDING) — it's a records + review
// workflow. One row per (store, kind).
model StoreDocument {
  id           String    @id @default(cuid())
  restaurantId String
  kind         String // FSSAI | GST | PAN | BANK
  number       String? // licence / registration / account number
  fileUrl      String? // uploaded scan (Cloudinary URL)
  holderName   String? // BANK: account holder name
  extra        Json? // BANK: { ifsc, bankName }; FSSAI: { expiryDate }
  status       String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewNote   String?   @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, kind])
  @@index([restaurantId])
  @@index([status])
}

// Vendor-level KYC/payout documents (PAN, GST certificate, bank details),
// collected during the 4-step vendor registration wizard. Mirrors
// StoreDocument's shape/review workflow, scoped to a vendor (User) instead
// of a Restaurant.
model VendorDocument {
  id           String    @id @default(cuid())
  vendorId     String
  kind         String // PAN | GST | BANK
  number       String? // PAN number / GSTIN / bank account number
  fileUrl      String? // uploaded scan (Cloudinary URL)
  holderName   String? // BANK: account holder name
  extra        Json? // BANK: { ifsc, bankName }
  status       String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewNote   String?   @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, kind])
  @@index([vendorId])
  @@index([status])
}

// A store's own delivery person — a lightweight name + phone contact, not a
// rider-app account. The store assigns one to a delivery order it fulfils
// itself (`Order.deliveryMode = SELF`) and then marks the order delivered.
model StoreDeliveryAgent {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId])
}

model RestaurantCuisine {
  restaurantId String
  cuisineId    String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine    Cuisine    @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  title        String
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foods         Food[]
  subCategories SubCategory[]

  @@index([restaurantId])
}

model Food {
  id             String   @id @default(cuid())
  restaurantId   String
  categoryId     String
  subCategoryId  String?
  title          String
  description    String?  @db.Text
  image          String?
  images         Json?
  badge          String? // e.g. "Diwali Special" — shown as a pill on menu cards
  isActive       Boolean  @default(true)
  isOutOfStock   Boolean  @default(false)
  // Combo / meal-deal: a Food with `isCombo` is a bundle sold at one price
  // (its single Variation). `comboItems` lists what's inside, for the customer
  // card and the kitchen ticket: [{ foodId, variationId?, title, quantity }].
  isCombo        Boolean  @default(false)
  comboItems     Json?
  compareAtPrice Float? // "worth ₹X" strike-through on combo cards
  // Merchant-curated "frequently bought together" — array of Food ids shown as
  // an upsell in the cart.
  pairedFoodIds  Json?
  // Per-item GST rate override, e.g. for a grocery/pharmacy store selling
  // goods at a different slab than the store's default. Null = inherit
  // Restaurant.tax (only meaningful when the store is gstRegistrationType REGULAR).
  gstRatePercent Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])
  variations  Variation[]
  orderItems  OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([subCategoryId])
}

model Variation {
  id           String  @id @default(cuid())
  foodId       String
  title        String
  price        Float
  discounted   Float?
  isOutOfStock Boolean @default(false)

  food       Food             @relation(fields: [foodId], references: [id], onDelete: Cascade)
  addons     VariationAddon[]
  orderItems OrderItem[]

  @@index([foodId])
}

model Addon {
  id              String  @id @default(cuid())
  restaurantId    String
  title           String
  description     String?
  quantityMinimum Int     @default(0)
  quantityMaximum Int     @default(1)
  // Explicit "customer must choose from this group" flag (Swiggy-style required
  // customization). Kept in sync with quantityMinimum on save.
  isRequired      Boolean @default(false)

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options         Option[]
  variations      VariationAddon[]
  orderItemAddons OrderItemAddon[]

  @@index([restaurantId])
}

model Option {
  id          String  @id @default(cuid())
  addonId     String
  title       String
  description String?
  price       Float   @default(0)

  addon                 Addon                  @relation(fields: [addonId], references: [id], onDelete: Cascade)
  orderItemAddonOptions OrderItemAddonOption[]

  @@index([addonId])
}

model VariationAddon {
  variationId String
  addonId     String

  variation Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  addon     Addon     @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([variationId, addonId])
}

model Configuration {
  id                     String  @id @default(cuid())
  currency               String  @default("USD")
  currencySymbol         String  @default("$")
  deliveryRate           Float   @default(0)
  termsAndConditions     String? @db.Text
  privacyPolicy          String? @db.Text
  testOtp                String?
  skipMobileVerification Boolean @default(true)
  skipEmailVerification  Boolean @default(true)
  skipWhatsAppOTP        Boolean @default(true)
  costType               String  @default("fixed")

  // Email (nodemailer) — generic SMTP when smtpHost is set, else falls back
  // to the Gmail service using email/emailPassword.
  email         String?
  emailName     String?
  enableEmail   Boolean @default(false)
  emailPassword String? // secret, never returned over GraphQL
  smtpHost      String?
  smtpPort      Int?
  smtpSecure    Boolean @default(false)
  smtpUser      String?

  // Contact form notification address (separate from the sender identity above)
  formEmail String?

  // SendGrid (currently no admin-panel screen submits this, kept for schema completeness)
  sendGridEnabled   Boolean @default(false)
  sendGridEmail     String?
  sendGridEmailName String?
  sendGridApiKey    String? // secret, never returned over GraphQL

  // PayPal
  paypalClientId     String?
  paypalSandbox      Boolean @default(true)
  paypalClientSecret String? // secret, never returned over GraphQL

  // Cashfree Payment Gateway (India — UPI/cards/netbanking/wallets)
  cashfreeAppId     String? // non-secret, safe to expose over GraphQL
  cashfreeSecretKey String? // secret, never returned over GraphQL
  cashfreeEnv       String  @default("TEST") // "TEST" | "PRODUCTION" — picks sandbox vs live Cashfree API host

  // Twilio
  twilioAccountSid     String?
  twilioPhoneNumber    String?
  twilioEnabled        Boolean @default(false)
  twilioWhatsAppNumber String?
  twilioAuthToken      String? // secret, never returned over GraphQL

  // WhatsApp Cloud API (Meta) — the launch channel for phone OTP + transactional
  // messages. `whatsappAccessToken` is a permanent System User token; it is
  // seeded from WHATSAPP_ACCESS_TOKEN (like SMTP_PASSWORD) and NEVER returned
  // over GraphQL. Everything else here is non-secret and admin-editable.
  whatsappCloudEnabled  Boolean @default(false)
  whatsappPhoneNumberId String? // Meta "phone number ID" (the send target, not the display number)
  whatsappWabaId        String? // WhatsApp Business Account ID (for template sync)
  whatsappApiVersion    String  @default("v22.0")
  whatsappAccessToken   String? @db.Text // secret (Meta System User tokens are ~200+ chars), never returned over GraphQL
  whatsappOtpTemplate   String  @default("localsell_otp")
  whatsappOtpLang       String  @default("en_US")

  // Sentry
  dashboardSentryUrl     String?
  webSentryUrl           String?
  apiSentryUrl           String?
  customerAppSentryUrl   String?
  restaurantAppSentryUrl String?
  riderAppSentryUrl      String?

  // Google Maps / OAuth client IDs
  googleMapsApiKey   String?
  webClientID        String?
  androidClientID    String?
  iOSClientID        String?
  expoClientID       String?
  googleMapLibraries String?
  googleColor        String?

  // Cloudinary
  cloudinaryUploadUrl String?
  cloudinaryApiKey    String?

  // Amplitude
  webAmplitudeApiKey String?
  appAmplitudeApiKey String?

  // Firebase (client-side web-app config, not the admin SDK service account)
  firebaseKey   String?
  authDomain    String?
  projectId     String?
  storageBucket String?
  msgSenderId   String?
  appId         String?
  measurementId String?
  vapidKey      String?

  // Misc app toggles
  isPaidVersion          Boolean @default(false)
  enableCustomerDemoMode Boolean @default(false)
  customerDemoZoneId     String?

  // Platform commission billing
  defaultCommissionRate  Float  @default(20)
  commissionBillingCycle String @default("MONTHLY") // MONTHLY | YEARLY

  // Billing entity shown on vendor commission invoices.
  platformLegalName String?
  platformAddress   String? @db.Text
  platformGstin     String?

  // Max undeposited COD cash a rider may hold before the app stops giving them
  // cash orders (Swiggy/Zomato-style cash limit).
  riderCashLimit Float @default(3000)

  // Marketplace home location (map-centre fallback for the store-location editor
  // and serviceability tie-breaks). Seeded to the launch town.
  defaultLatitude  Float?
  defaultLongitude Float?
}

// Immutable per-order commission ledger. One row is written when an order is
// first marked DELIVERED; the rate is snapshotted so later rate changes don't
// rewrite history.
//
// `selfCollected` = the platform already kept this commission through the money
//   flow (online payment, or the rider depositing the full COD cash) — it is
//   never invoiced, it only counts toward "commission earned" in reports.
// `selfCollected = false` (COD + pickup: the store holds the cash) → the store
//   owes it → `billId` stays null until it's rolled into a CommissionBill.
model CommissionRecord {
  id               String   @id @default(cuid())
  orderId          String   @unique
  orderNumber      String
  restaurantId     String
  vendorId         String
  foodSubtotal     Float
  commissionRate   Float
  commissionAmount Float
  paymentMethod    String   @default("COD")
  isPickedUp       Boolean  @default(false)
  selfCollected    Boolean  @default(true)
  orderDeliveredAt DateTime
  billId           String?
  createdAt        DateTime @default(now())

  @@index([vendorId])
  @@index([restaurantId])
  @@index([billId])
  @@index([selfCollected])
}

// One invoice per vendor per billing period. Generated by an admin closing a
// period; the platform collects the amount out-of-band (COD) and marks it PAID.
model CommissionBill {
  id                String    @id @default(cuid())
  vendorId          String
  periodStart       DateTime
  periodEnd         DateTime
  cycle             String // MONTHLY | YEARLY
  orderCount        Int       @default(0)
  grossFoodSubtotal Float     @default(0)
  commissionTotal   Float     @default(0)
  status            String    @default("PENDING") // PENDING | PAID | WAIVED
  invoiceNumber     String?   @unique
  paidAt            DateTime?
  paidAmount        Float?
  note              String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vendorId])
  @@index([status])
}

// Immutable receipts for commission received from stores/vendors, including partial payments.
model CommissionPayment {
  id             String   @id @default(cuid())
  billId         String
  vendorId       String
  amount         Float
  method         String
  reference      String?
  note           String?  @db.Text
  receivedAt     DateTime
  recordedById   String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([billId])
  @@index([vendorId, receivedAt])
}

// CASHFREE's mirror of CommissionRecord: the platform's single Cashfree
// merchant account collects 100% of these orders, so — unlike COD, where the
// store already holds the cash and owes the platform commission — here the
// platform holds the cash and owes the vendor their net share. Written once,
// when a CASHFREE order is first marked DELIVERED (see recordVendorPayable).
model VendorPayable {
  id               String   @id @default(cuid())
  orderId          String   @unique
  orderNumber      String
  restaurantId     String
  vendorId         String
  orderAmount      Float
  commissionAmount Float
  netPayable       Float
  status           String   @default("PENDING") // PENDING | PAID
  payoutId         String?
  orderDeliveredAt DateTime
  createdAt        DateTime @default(now())

  @@index([vendorId])
  @@index([restaurantId])
  @@index([status])
  @@index([payoutId])
}

// Immutable receipts for money paid out to vendors against their VendorPayables.
model VendorPayout {
  id             String   @id @default(cuid())
  vendorId       String
  amount         Float
  method         String
  reference      String?
  note           String?  @db.Text
  paidAt         DateTime
  recordedById   String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([vendorId, paidAt])
}

// Records money- and access-level admin actions: who changed a commission
// rate, marked a bill paid, settled a payout, approved a store, edited config,
// touched staff / permissions. Written explicitly by `recordAudit()` at those
// mutations — not a blanket middleware.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorType  String?
  action     String
  targetType String?
  targetId   String?
  summary    String?  @db.Text
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// COD cash a rider physically collected on delivery. The rider keeps their
// delivery fee + tip; the rest (store payout + platform commission + tax) is
// cash the rider is holding on the platform's behalf and must remit. One row
// per COD delivery; `remittanceId` links it to the settlement it was cleared in.
model RiderCashEntry {
  id             String   @id @default(cuid())
  orderId        String   @unique
  orderNumber    String
  riderId        String
  collectedTotal Float
  riderKeeps     Float
  owedToPlatform Float
  deliveredAt    DateTime
  remittanceId   String?
  createdAt      DateTime @default(now())

  @@index([riderId])
  @@index([remittanceId])
}

// A rider handing collected COD cash back to the platform. Clears one or more
// RiderCashEntry rows (oldest first).
model RiderCashRemittance {
  id           String    @id @default(cuid())
  riderId      String
  amount       Float
  entryCount   Int       @default(0)
  method       String? // cash | bank | upi
  reference    String? // UPI ref / deposit slip no.
  note         String?   @db.Text
  recordedById String?
  // A rider self-reports a deposit as PENDING; an admin CONFIRMs it, and only
  // then are the RiderCashEntry rows cleared. Admin-entered remittances are
  // CONFIRMED immediately.
  status       String    @default("CONFIRMED") // PENDING | CONFIRMED | REJECTED
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([riderId])
  @@index([status])
}

// A manual credit (+) or debit (-) an admin applies to a store or rider wallet:
// a goodwill credit, a chargeback, correcting a bad payout, a penalty. Moves the
// wallet immediately; the row is the paper trail. `runItemId` is set when a
// payout run consumes it into a statement line.
model WalletAdjustment {
  id             String   @id @default(cuid())
  subjectType    String // STORE | RIDER
  restaurantId   String?
  riderId        String?
  amount         Float // signed: positive = credit, negative = debit
  reason         String // slug: goodwill | chargeback | correction | penalty | other
  note           String?  @db.Text
  createdById    String?
  createdByEmail String?
  runItemId      String?
  createdAt      DateTime @default(now())

  @@index([restaurantId])
  @@index([riderId])
  @@index([runItemId])
}

// A batch of payouts an admin settles together (a weekly run). Snapshots each
// payee's wallet at run time into PayoutRunItem rows; the admin then marks each
// line paid with a bank/UPI reference.
model PayoutRun {
  id          String    @id @default(cuid())
  label       String // e.g. "Week of 1 Sep 2026"
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("OPEN") // OPEN | COMPLETED
  itemCount   Int       @default(0)
  grossTotal  Float     @default(0)
  paidTotal   Float     @default(0)
  note        String?   @db.Text
  createdById String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  items PayoutRunItem[]

  @@index([status])
}

model PayoutRunItem {
  id            String    @id @default(cuid())
  runId         String
  subjectType   String // STORE | RIDER
  restaurantId  String?
  riderId       String?
  payeeName     String
  walletBalance Float // currentWalletAmount at snapshot time
  heldCash      Float     @default(0) // rider undeposited COD held against the wallet
  amount        Float // what we actually pay out this run (wallet - heldCash, clamped >=0)
  status        String    @default("PENDING") // PENDING | PAID | SKIPPED
  method        String? // bank | upi | cash
  reference     String?
  note          String?   @db.Text
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  run PayoutRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([restaurantId])
  @@index([riderId])
  @@index([status])
}

model Order {
  id                   String        @id @default(cuid())
  orderId              String        @unique
  userId               String
  restaurantId         String
  riderId              String?
  addressId            String?
  paymentMethod        String
  paymentStatus        PaymentStatus @default(PENDING)
  // Cashfree's own payment id for this order, set once the webhook reports a
  // terminal outcome — useful for support/refund lookups. Null for COD and
  // for a CASHFREE order still awaiting the webhook.
  paymentGatewayRef    String?
  // Cashfree's own order_id for the CURRENT payment attempt. Cashfree rejects
  // creating a new order under an order_id that already exists, so a retry
  // ("Pay Again" after an abandoned/failed attempt) needs a fresh one each
  // time — it can't just reuse Order.id like the very first attempt did.
  // Format: "<Order.id>-<attempt>", so the webhook can still resolve back to
  // this row without a separate mapping table (see cashfree-confirm.ts).
  cashfreeOrderId      String?       @unique
  // Refund of a CASHFREE payment after cancellation. refundId is our own id
  // sent to Cashfree (format "<Order.id>-refund-<attempt>", unique per
  // attempt so a retry after a failure can't collide) — the webhook and
  // retryOrderRefund both key off it. refundedAmount/refundedAt are only set
  // once Cashfree confirms SUCCESS; refundError carries the last failure
  // reason so support/admin can see why a retry is needed.
  refundStatus         RefundStatus  @default(NONE)
  refundId             String?       @unique
  refundedAmount       Float?
  refundedAt           DateTime?
  refundError          String?       @db.Text
  orderStatus          OrderStatus   @default(PENDING)
  status               String        @default("ACTIVE")
  paidAmount           Float         @default(0)
  orderAmount          Float
  deliveryCharges      Float         @default(0)
  tipping              Float         @default(0)
  taxationAmount       Float         @default(0)
  // CGST/SGST split of taxationAmount, populated only for a REGULAR store's
  // order (intra-state only — this platform is same-city hyperlocal delivery,
  // so there's no IGST branch). Null for COMPOSITION/UNREGISTERED orders,
  // where taxationAmount is always 0.
  cgstAmount           Float?
  sgstAmount           Float?
  discountAmount       Float         @default(0)
  instructions         String?       @db.Text
  // Optional contact number for whoever is actually receiving the order,
  // when that's not the account holder (e.g. ordering for someone else at
  // a different address). Store/rider call this number instead of the
  // orderer's own phone when it's set.
  recipientPhone       String?
  isPickedUp           Boolean       @default(false)
  // How this order is fulfilled. Kept in sync with `isPickedUp`
  // (PICKUP ⇔ isPickedUp). SELF = the store's own delivery person;
  // PLATFORM = the LocalSell rider fleet.
  deliveryMode         String        @default("PLATFORM") // PICKUP | SELF | PLATFORM
  storeDeliveryAgentId String?
  // Proof of delivery. A 4-digit code shown to the customer while the order is
  // out for delivery; whoever delivers (LocalSell rider or the store's own
  // person) must enter it to close the order. Cleared once DELIVERED.
  deliveryOtp          String?
  deliveryConfirmedBy  String? // OTP | MANUAL
  orderDate            DateTime      @default(now())
  expectedTime         DateTime?
  acceptedAt           DateTime?
  pickedAt             DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  assignedAt           DateTime?
  reason               String?       @db.Text
  // Who initiated the cancellation and a display-name snapshot at that
  // moment — lets the customer/admin UI show "Cancelled by the store" (or
  // admin) without an extra join, and without breaking if that user's name
  // changes later.
  cancelledByType      UserType?
  cancelledByName      String?
  isRinged             Boolean       @default(false)
  preparationTime      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user               User                @relation("OrderCustomer", fields: [userId], references: [id])
  rider              User?               @relation("OrderRider", fields: [riderId], references: [id])
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id])
  address            Address?            @relation(fields: [addressId], references: [id])
  storeDeliveryAgent StoreDeliveryAgent? @relation(fields: [storeDeliveryAgentId], references: [id])
  items              OrderItem[]
  review             Review?
  chatMessages       OrderChatMessage[]

  @@index([userId])
  @@index([restaurantId])
  @@index([riderId])
  @@index([storeDeliveryAgentId])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  foodId              String
  variationId         String?
  title               String
  price               Float
  quantity            Int
  specialInstructions String? @db.Text

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  food      Food             @relation(fields: [foodId], references: [id])
  variation Variation?       @relation(fields: [variationId], references: [id])
  addons    OrderItemAddon[]

  @@index([orderId])
  @@index([foodId])
}

model OrderItemAddon {
  id          String @id @default(cuid())
  orderItemId String
  addonId     String
  title       String

  orderItem OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon     Addon                  @relation(fields: [addonId], references: [id])
  options   OrderItemAddonOption[]

  @@index([orderItemId])
}

model OrderItemAddonOption {
  id               String @id @default(cuid())
  orderItemAddonId String
  optionId         String
  title            String
  price            Float
  // How many units of this option (e.g. 2x Tawa Roti). The client expresses
  // this by repeating the option's id in OrderAddonInput.options that many
  // times — no API shape change needed, the resolver just counts occurrences.
  quantity         Int    @default(1)

  orderItemAddon OrderItemAddon @relation(fields: [orderItemAddonId], references: [id], onDelete: Cascade)
  option         Option         @relation(fields: [optionId], references: [id])

  @@index([orderItemAddonId])
}

model Zone {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  boundary    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  riders RiderProfile[]
}

model RiderProfile {
  id                    String  @id @default(cuid())
  userId                String  @unique
  vehicleType           String?
  available             Boolean @default(true)
  assigned              Json?   @default("[]")
  zoneId                String?
  licenseDetails        Json?
  vehicleDetails        Json?
  bussinessDetails      Json?
  latitude              Float?
  longitude             Float?
  timeZone              String?
  workSchedule          Json?
  currentWalletAmount   Float   @default(0)
  totalWalletAmount     Float   @default(0)
  withdrawnWalletAmount Float   @default(0)
  // INDEPENDENT | STORE_ASSIGNED
  employmentType        String  @default("INDEPENDENT")
  assignedStoreId       String?
  assignedStore         Restaurant? @relation("RiderAssignedStore", fields: [assignedStoreId], references: [id], onDelete: SetNull)

  // PENDING | APPROVED | REJECTED — every new rider (admin-created or a
  // self-registration from the app) starts PENDING and cannot go online or
  // take orders until an admin explicitly approves them (mirrors Restaurant's
  // gate). Seed / migration data may set APPROVED explicitly.
  approvalStatus String    @default("PENDING")
  approvalNote   String?   @db.Text
  approvedAt     DateTime?
  approvedById   String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone Zone? @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
  @@index([assignedStoreId])
}

model RiderDocument {
  id           String    @id @default(cuid())
  riderId      String
  kind         String // LICENSE | IDENTITY | BANK
  number       String?
  fileUrl      String?
  holderName   String?
  extra        Json?
  status       String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewNote   String?   @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rider User @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([riderId, kind])
  @@index([riderId])
  @@index([status])
}

model SubCategory {
  id               String @id @default(cuid())
  title            String
  parentCategoryId String

  parentCategory Category @relation(fields: [parentCategoryId], references: [id], onDelete: Cascade)
  foods          Food[]

  @@index([parentCategoryId])
}

model Coupon {
  id             String    @id @default(cuid())
  title          String
  discount       Float     @default(0)
  enabled        Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  lifeTimeActive Boolean   @default(false)
  // Only redeemable by a user placing their first-ever order.
  firstOrderOnly Boolean   @default(false)
  restaurantId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Review {
  id           String   @id @default(cuid())
  orderId      String   @unique
  restaurantId String
  userId       String
  rating       Int
  description  String?  @db.Text
  comments     String?  @db.Text
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
}

model WithdrawRequest {
  id            String   @id @default(cuid())
  requestId     String   @unique
  riderId       String?
  restaurantId  String?
  requestAmount Float
  status        String   @default("PENDING")
  requestTime   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rider       User?        @relation(fields: [riderId], references: [id], onDelete: Cascade)
  restaurant  Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([riderId])
  @@index([restaurantId])
}

model Transaction {
  id                String   @id @default(cuid())
  transactionId     String   @unique
  withdrawRequestId String?  @unique
  riderId           String?
  restaurantId      String?
  userType          UserType
  amountTransferred Float
  amountCurrency    String   @default("USD")
  status            String   @default("COMPLETED")
  createdAt         DateTime @default(now())

  withdrawRequest WithdrawRequest? @relation(fields: [withdrawRequestId], references: [id], onDelete: SetNull)
  rider           User?            @relation(fields: [riderId], references: [id], onDelete: Cascade)
  restaurant      Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([restaurantId])
}

model Banner {
  id          String    @id @default(cuid())
  title       String?
  description String?   @db.Text
  action      String?
  screen      String?
  file        String?
  parameters  Json?
  // Festival-campaign scheduling
  startDate   DateTime?
  endDate     DateTime?
  placement   String?   @default("HOME") // HOME | STORE | LANDING
  priority    Int       @default(0)
  couponCode  String?
  isActive    Boolean   @default(true)

  @@index([placement])
}

// A visitor whose chosen delivery location no store covers yet. Captured from the
// web / customer-app "not available in your area" screen so we know where to expand.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  latitude  Float
  longitude Float
  areaLabel String?
  source    String?  @default("web") // web | app
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String?
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model WebNotification {
  id         String   @id @default(cuid())
  userId     String
  body       String   @db.Text
  navigateTo String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String   @db.Text
  category     String
  status       String   @default("open")
  orderId      String?
  otherDetails String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  content    String   @db.Text
  senderType String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model OrderChatMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  message   String?  @db.Text
  image     String?
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([senderId])
}

// Pre-signup / passwordless phone verification. Decoupled from User so an OTP
// can be issued for a phone number that has no account yet (signup) as well as
// one that does (login, password reset). One live row per phone number.
model PhoneVerification {
  id         String    @id @default(cuid())
  phone      String    @unique
  code       String
  purpose    String    @default("SIGNUP") // SIGNUP | LOGIN | PASSWORD_RESET | PHONE_CHANGE
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Registry of the Meta-approved WhatsApp templates the platform sends. Maps an
// internal event `key` (e.g. "otp_verify") to the exact template `metaName` +
// language registered in WhatsApp Manager, so events can be re-pointed at a new
// template from the admin panel without a redeploy, and so the code still knows
// what to send when Meta pauses/rejects one. `status` mirrors Meta's review
// state (kept fresh by the template-status webhook / a manual sync).
model WhatsappTemplate {
  id            String    @id @default(cuid())
  key           String    @unique
  metaName      String
  language      String    @default("en")
  category      String    @default("AUTHENTICATION") // AUTHENTICATION | UTILITY | MARKETING
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | PAUSED | DISABLED
  bodyText      String?   @db.Text // local copy of the body, for admin preview / audit
  headerType    String? // NONE | TEXT | IMAGE | VIDEO | DOCUMENT
  headerMediaId String? // default header media asset id, when the template has a media header
  variableMap   Json? // ordered describe of {{1}},{{2}}… -> which runtime value fills it
  buttonType    String? // NONE | OTP | URL | QUICK_REPLY
  isActive      Boolean   @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One row per outbound phone message (WhatsApp Cloud, Twilio WhatsApp, or SMS).
// Drives deliverability debugging, per-role usage/volume reporting ("how many
// customers / vendors / riders got an OTP this month"), and the WhatsApp bill
// estimate (Meta charges per conversation, by category).
model WhatsappMessageLog {
  id            String   @id @default(cuid())
  toPhone       String
  userId        String?
  userType      String? // CUSTOMER | VENDOR | RIDER | ADMIN | STAFF — denormalised for reporting
  channel       String   @default("WHATSAPP_CLOUD") // WHATSAPP_CLOUD | WHATSAPP_TWILIO | SMS | CONSOLE
  purpose       String // OTP_SIGNUP | OTP_LOGIN | OTP_PHONE_CHANGE | PASSWORD_RESET | ORDER_UPDATE | ADMIN_BROADCAST
  templateKey   String?
  metaMessageId String?
  status        String   @default("SENT") // QUEUED | SENT | DELIVERED | READ | FAILED | FALLBACK
  errorCode     String?
  errorDetail   String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([toPhone])
  @@index([createdAt])
  @@index([purpose])
}
